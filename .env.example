# Copy to .env and fill in. Never commit .env.
#
# Production-safe defaults. The backend refuses to start when SPORTS_DEBUG is
# false and either the JWT secret is still the public dev default or dev
# fixtures are enabled — so copying this file as-is cannot silently ship
# fictional data or a forgeable token secret.

SPORTS_DEBUG=false
# REQUIRED when SPORTS_DEBUG=false. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SPORTS_JWT_SECRET=

SPORTS_DATABASE_URL=postgresql+asyncpg://sports:sports@localhost:5434/sportsdb
SPORTS_REDIS_URL=redis://localhost:6381/0

# Fictional demo athletes/events and the live simulator endpoint.
# Only permitted alongside SPORTS_DEBUG=true.
SPORTS_ENABLE_DEV_FIXTURES=false

# ---- Local development ----------------------------------------------------
# Uncomment for a local dev box to get demo data and the live simulator:
# SPORTS_DEBUG=true
# SPORTS_ENABLE_DEV_FIXTURES=true
