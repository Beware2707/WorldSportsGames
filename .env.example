# Copy to .env and fill in. Never commit .env.
SPORTS_JWT_SECRET=generate-a-long-random-secret
SPORTS_DATABASE_URL=postgresql+asyncpg://sports:sports@localhost:5434/sportsdb
SPORTS_REDIS_URL=redis://localhost:6381/0
# Fictional demo athletes — development only, keep false in production.
SPORTS_ENABLE_DEV_FIXTURES=true
